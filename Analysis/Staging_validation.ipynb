from sqlalchemy import create_engine
import pandas as pd

# Conexión usando SQLAlchemy con psycopg2
engine = create_engine("postgresql+psycopg2://postgres:@localhost:5432/postgres")

# Ejemplo: leer ventas por cliente
df_customers = pd.read_sql("SELECT * FROM gold.sales_by_customer;", engine)
print(df_customers.head())

# Validación: KPIs positivos
df_sales = pd.read_sql("SELECT * FROM gold.kpi_total_sales;", engine)
print("Ventas totales:", df_sales.iloc[0,0])
